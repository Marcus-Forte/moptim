{
    "name": "moptim",
    "image": "mdnf1992/cpp-dev", // mdnf1992/sycl-dev for SYCL support
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools-extension-pack",
                "llvm-vs-code-extensions.vscode-clangd",
                "cschlosser.doxdocgen",
                "jebbs.plantuml"
            ],
            "settings": {
                "clangd.arguments": [ 
                     "-header-insertion=never"
                ]
            }
        }
    },
    "mounts": [
        "source=moptim-build-cache,target=/workspaces/moptim/build,type=volume",
        "source=moptim-build-sycl-cache,target=/workspaces/moptim/build_sycl,type=volume"
    ]
    // "runArgs": ["--gpus", "all", "--cap-add=SYS_ADMIN"] // uncomment for GPU usage
}