{
  "version": 3,
  "configurePresets": [
    {
        "name": "default",
        "hidden": true,
        "cacheVariables": {
            "CMAKE_TOOLCHAIN_FILE": "/opt/toolchains/native.cmake"
        }
    },
    {
      "name": "default-with-sycl",
      "displayName": "Build with SYCL",
      "description": "Build moptim with SYCL support enabled",
      "inherits": "default",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "WITH_SYCL": "ON"
      },
      "binaryDir": "${sourceDir}/build-sycl"
    },
    {
      "name": "default-without-sycl",
      "displayName": "Build without SYCL",
      "description": "Build moptim without SYCL support",
      "inherits": "default",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "WITH_SYCL": "OFF"
      },
      "binaryDir": "${sourceDir}/build"
    }
  ]
}
