{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Host",
            "description": "moptim with the image's GCC; the partitions of large costs run on oneTBB when it is found",
            "toolchainFile": "/opt/toolchain/gcc.cmake",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            },
            "binaryDir": "${sourceDir}/build"
        }
    ]
}
